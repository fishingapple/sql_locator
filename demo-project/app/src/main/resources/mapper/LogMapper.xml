<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.log.LogMapper">

    <!-- 用例 T8：两表 JOIN（t_log + t_user）→ 其他只含其中一张表的语句会走"表重合" -->
    <select id="selectLogWithUser" resultType="map">
        SELECT l.id, l.action, u.name
        FROM t_log l
        JOIN t_user u ON l.user_id = u.id
        WHERE l.id = #{id}
    </select>

</mapper>
